{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "src/main.py (后端测试用例，使用默认ticker)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "src/main.py (uv run - AAPL,MSFT,NVDA)",
            "type": "debugpy",
            "request": "launch",
            "module": "uv",
            "args": [
                "run",
                "python",
                "src/main.py",
                "--ticker",
                "AAPL,MSFT,NVDA",
                "--show-reasoning"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "src/main.py (uv run - 自定义参数)",
            "type": "debugpy",
            "request": "launch",
            "module": "uv",
            "args": [
                "run",
                "python",
                "src/main.py",
                "--ticker",
                "${input:tickers}",
                "--show-reasoning"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },

        {
            "name": "DeerFlow Frontend",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/app/frontend",
            "command": "/Users/sss/.nvm/versions/node/v22.14.0/bin/pnpm dev",
            "serverReadyAction": {
                "pattern": "- Local:.*(https?://localhost:3000)",
                "uriFormat": "%s",
                "action": "debugWithChrome"
            }
        },
        {
            "name": "DeerFlow Frontend Win",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/app/frontend",
            "command": "pnpm dev",
            "serverReadyAction": {
                "pattern": "- Local:.*(https?://localhost:3000)",
                "uriFormat": "%s",
                "action": "debugWithEdge"
            }
        },
        {
            "name": "app/backend（后台服务）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app/backend/main.py",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ],
    "inputs": [
        {
            "id": "tickers",
            "description": "输入股票代码（逗号分隔）",
            "default": "AAPL,MSFT,NVDA",
            "type": "promptString"
        }
    ]
}